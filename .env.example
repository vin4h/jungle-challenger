# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Host port mapping for docker compose (left-hand side of "HOST:CONTAINER").
# Override in a local .env if these ports are already taken on your machine.
# ---------------------------------------------------------------------------
POSTGRES_PORT=5432
LOCALSTACK_PORT=4566
KEYCLOAK_PORT=8080

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://jungle:jungle@localhost:5432/jungle
DB_LOGGING=false

# ---------------------------------------------------------------------------
# AWS SQS (LocalStack / MiniStack locally)
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo

# ---------------------------------------------------------------------------
# SQS consumer (README section 10). Disabled by default: enable it where the
# worker should actually poll the queue (e.g. the running service).
# ---------------------------------------------------------------------------
SQS_CONSUMER_ENABLED=false
SQS_CONSUMER_MAX_MESSAGES=10
SQS_CONSUMER_WAIT_SECONDS=20

# ---------------------------------------------------------------------------
# Outbound events (README section 11): the outbox publisher drains
# outbox_messages into the wager-events.fifo queue.
# ---------------------------------------------------------------------------
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo
SQS_EVENTS_DLQ_URL=http://localhost:4566/000000000000/wager-events-dlq.fifo
OUTBOX_PUBLISHER_ENABLED=false
OUTBOX_PUBLISHER_BATCH_SIZE=20
OUTBOX_PUBLISHER_INTERVAL_MS=1000
OUTBOX_LEASE_MS=30000

# ---------------------------------------------------------------------------
# Pending-reference worker (README section 7.1): reprocesses transactions
# waiting for a reference (REFUND/ROLLBACK) with exponential backoff.
# ---------------------------------------------------------------------------
PENDING_REFERENCE_WORKER_ENABLED=false
PENDING_REFERENCE_BATCH_SIZE=20
PENDING_REFERENCE_INTERVAL_MS=5000
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_BACKOFF_MS=30000
PENDING_REFERENCE_MAX_BACKOFF_MS=3600000

# ---------------------------------------------------------------------------
# Auth (Keycloak) — see section 2 of the challenge; does not score points.
# Set AUTH_ENABLED=false to bypass the guard entirely (health is always public).
# ---------------------------------------------------------------------------
AUTH_ENABLED=true
KEYCLOAK_ISSUER=http://localhost:8080/realms/jungle
KEYCLOAK_AUDIENCE=wagering-api
